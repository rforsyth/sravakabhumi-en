{
  "sbh3.1:0.1": "Śrāvakabhūmi ",
  "sbh3.1:0.2": "navākārā cittasthitiḥ ",
  "sbh3.1:1.1": "ekāgratā śamathapakṣyā vipaśyanāpakṣyā ca | ",
  "sbh3.1:1.2": "tatra yā navākārāyāṁ cittasaṁtathau sthitau vā sā śamathapakṣyā, yā punaścaturvidhe prajñādhāre sā vipaśyanāpakṣyā | ",
  "sbh3.1:2.1": "tatra navākārā cittasthitiḥ katamā | ",
  "sbh3.1:2.2": "iha bhikṣuradhyātmameva cittaṁ sthāpayati | ",
  "sbh3.1:2.3": "saṁsthāpayati | ",
  "sbh3.1:2.4": "avasthāpayatyupasthāpayati | ",
  "sbh3.1:2.5": "damayati | ",
  "sbh3.1:2.6": "śamayati | ",
  "sbh3.1:2.7": "vyupaśamayati | ",
  "sbh3.1:2.8": "ekotīkaroti | ",
  "sbh3.1:2.9": "samādhatte | ",
  "sbh3.1:3.1": "kathaṁ sthāpayati | ",
  "sbh3.1:3.2": "sarvabāhyebhya ālambanebhyaḥ pratisaṁkṣipyādhyātmamavikṣepāyopanibaghnāti | ",
  "sbh3.1:3.3": "yattatprathamopanibaddho vikṣepāya iyaṁ sthāpanā | ",
  "sbh3.1:4.1": "kathaṁ saṁsthāpayati | ",
  "sbh3.1:4.2": "tatprathamopanibaddhaṁ yadeva cittaṁ tadbalamaudārikamasaṁsthitamaparisaṁsthitaṁ tasminnevālambane pravarddhanayogena prasādayogena sābhinigrahaṁ sūkṣmīkurvan abhisaṁkṣipan saṁsthāpayati | ",
  "sbh3.1:5.1": "kathamavasthāpayati | ",
  "sbh3.1:5.2": "sa ceccittameva sthāpayataḥ | ",
  "sbh3.1:5.3": "smṛtisaṁpramoṣādbahirdhā vikṣipyate | ",
  "sbh3.1:6.1": "sa kathaṁ damayati | ",
  "sbh3.1:6.2": "yairnimittairasya taccittaṁ vikṣipyate | ",
  "sbh3.1:6.3": "tadyathā gatvarasaṁspraṣṭavyanimittai rāgadveṣamohastrīpuruṣanimitaiśca | ",
  "sbh3.1:6.4": "tatrānena pūrvamevādīnavasaṁjñodgṛhītā bhavati | ",
  "sbh3.1:6.5": "tāmadhipatiṁ kṛtvā teṣu nimitteṣu tasya cittasya prasaraṁ na dadāti | ",
  "sbh3.1:6.6": "evaṁ damayati | | ",
  "sbh3.1:7.1": "kathaṁ śamayati | ",
  "sbh3.1:7.2": "yairvitarkaiḥ kāmavitarkādibhiḥ | ",
  "sbh3.1:7.3": "yaiścopakleśaiḥ | ",
  "sbh3.1:7.4": "kāmacchandanivaraṇādibhiḥ | ",
  "sbh3.1:7.5": "tasya cetasaḥ saṁkṣobho bhavati | ",
  "sbh3.1:7.6": "tatrānena pūrvamevādīnavasaṁjñodgṛhītā bhavati | ",
  "sbh3.1:7.7": "tāmadhipatiṁ kṛtvā tasya cetasaḥ | ",
  "sbh3.1:7.8": "teṣu vitarkopakleśeṣu | ",
  "sbh3.1:7.9": "prasaraṁ na dadātyevaṁ śamayati | ",
  "sbh3.1:8.1": "kathaṁ vyupaśamayati | ",
  "sbh3.1:8.2": "smṛtisampramoṣāttadubhayasamudācāre satyutpannotpannān vitarkopakleśān nādhivāsayati | ",
  "sbh3.1:8.3": "prajahāti | ",
  "sbh3.1:8.4": "evaṁ vyupaśamayati | ",
  "sbh3.1:9.1": "kathamekotīkaroti | ",
  "sbh3.1:9.2": "sābhisaṁskāraṁ niścchidraṁ nirantaraṁ samādhipravāhamavasthāpayatyevamekotīkaroti | ",
  "sbh3.1:10.1": "kathaṁ samādhatte | ",
  "sbh3.1:10.2": "āsevanānvayādbhāvanānvayādbahulīkārānvayādanābhogavāhanaṁ | ",
  "sbh3.1:10.3": "svarasavāhanaṁ | ",
  "sbh3.1:10.4": "mārgaṁ labhate | ",
  "sbh3.1:10.5": "yenānabhisaṁskāreṇānābhogenāsya cittasamādhipravāhaḥ | ",
  "sbh3.1:10.6": "avikṣepe pravarttate | ",
  "sbh3.1:10.7": "evaṁ samādhatte | ",
  "sbh3.1:11.1": "tatra ṣaḍvidhabalairnavākārā cittasthitiḥ sampadyate | ",
  "sbh3.1:11.2": "tadyathā śrutacintābalena | smṛtibalena | vīryabalena | paricayabalena ca | ",
  "sbh3.1:12.1": "tatra śrutacintābalena tāvat | ",
  "sbh3.1:12.2": "yacchrutaṁ, yā cintā tāmadhipatiṁ kṛtvā cittamādita ālambane sthāpayati | ",
  "sbh3.1:12.3": "tatraiva ca | ",
  "sbh3.1:12.4": "prabandhayogena saṁsthāpayati | ",
  "sbh3.1:12.5": "tatropanibaddhaṁ cittaṁ smṛtibalena pratisarannavasthāpayati | ",
  "sbh3.1:12.6": "upasthāpayati | ",
  "sbh3.1:12.7": "tataḥ saṁprajanyabalena nimittavitarkopakleśeṣu prasaramananuprayacchan damayati | ",
  "sbh3.1:12.8": "śamayati | ",
  "sbh3.1:12.9": "vīryabalena | ",
  "sbh3.1:12.10": "tadubhayasamudācāraṁ ca nādhivāsayati | ",
  "sbh3.1:12.11": "ekotīkaroti | ",
  "sbh3.1:12.12": "paricayabalena samādhatte | ",
  "sbh3.1:13.1": "tatra navākārāyāṁ cittasthitau catvāro manaskārā veditavyāḥ | ",
  "sbh3.1:13.2": "balavāhanaḥ sacchidravāhano niścchidravāhanaḥ | anābhogavāhanaśca | ",
  "sbh3.1:14.1": "tatra sthāpayataḥ, saṁsthāpayato balavāhano manaskāraḥ | ",
  "sbh3.1:14.2": "avasthāpayata, upasthāpayato, damayataḥ, śamayataḥ, vyupaśamayataḥ, sacchidravāhano manaskāraḥ | ",
  "sbh3.1:14.3": "ekotīkurvato niścchidravāhano manaskāraḥ | ",
  "sbh3.1:14.4": "samādadhataḥ | anābhogavāhano manaskāro bhavati | ",
  "sbh3.1:15.1": "evamete manaskārāyāṁ cittasthitau śamathapakṣyā bhavanti | ",
  "sbh3.1:15.2": "yaḥ punarevamadhyātmaṁ cetaḥśamathasya lābhī vipaśyanāyāṁ prayujyate | ",
  "sbh3.1:15.3": "tasyaita eva catvāro manaskārā vipaśyanāpakṣyā bhavanti | | "
}
