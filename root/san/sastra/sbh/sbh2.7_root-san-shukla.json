{
  "sbh2.7:0.1": "Śrāvakabhūmi ",
  "sbh2.7:0.2": "kauśalyālambanam ",
  "sbh2.7:1.1": "tatra kauśalālambanaṁ kauśalyālambanaṁ ca katamat tadyathā | ",
  "sbh2.7:1.2": "skandhakauśalyaṁ, dhātukauśalyamāyatanakauśalyaṁ, pratītyasamutpādakauśalyaṁ, sthānāsthānakauśalyaṁ | ",
  "sbh2.7:2.1": "tatra katame skandhāḥ, katamat skandhakauśalyaṁ | ",
  "sbh2.7:2.2": "āha | ",
  "sbh2.7:2.3": "pañca skandhāḥ | ",
  "sbh2.7:2.4": "rūpaskandho vedanāskandhaḥ saṁjñāskandhaḥ saṁskāraskandho vijñānaskandhaśca | ",
  "sbh2.7:3.1": "tatra rūpaskandho yatkiṁcidrūpaṁ sarvaṁ taccatvāri mahābhūtāni | ",
  "sbh2.7:3.2": "catvāri mahābhūtānyupādāya | ",
  "sbh2.7:3.3": "tatpunaratītānāgatapratyutpannamādhyātmikaṁ vā, bāhyaṁ vā, audārikaṁ vā, sūkṣmaṁ vā, hīnaṁ vā, praṇītaṁ vā, dūre vā, antike vā | ",
  "sbh2.7:4.1": "tatra vedanāskandhaḥ katamaḥ | ",
  "sbh2.7:4.2": "sukhavedanīyaṁ vā sparśaṁ pratītya, duḥkhavedanīyaṁ vā, aduḥkhāsukhavedanīyaṁ vā | ",
  "sbh2.7:4.3": "ṣaḍ vedanākāyāḥ | ",
  "sbh2.7:4.4": "cakṣuḥsaṁsparśajā vedanā | ",
  "sbh2.7:4.5": "śrotraghrāṇajihvākāyamanaḥsaṁsparśajā vedanā | ",
  "sbh2.7:5.1": "tatra saṁjñāskandhaḥ katamaḥ | ",
  "sbh2.7:5.2": "tadyathā sanimittasaṁjñā, animittasaṁjñā, parīttasaṁjñā | ",
  "sbh2.7:5.3": "mahadgatasaṁjñā | ",
  "sbh2.7:5.4": "apramāṇasaṁjñā | ",
  "sbh2.7:5.5": "nāsti kiñcidityākiñcanyāyatanasaṁjñā | ",
  "sbh2.7:5.6": "ṣaṭ saṁjñākāyāḥ | ",
  "sbh2.7:5.7": "cakṣuḥsaṁsparśajā saṁjñā | ",
  "sbh2.7:5.8": "śrotraghrāṇajihvākāyamanaḥsaṁsparśajā saṁjñā | ",
  "sbh2.7:6.1": "saṁskāraskandhaḥ katamaḥ | ",
  "sbh2.7:6.2": "ṣaṭ cetanākāyāḥ cakṣuḥsaṁsparśajā cetanā, śrotraghrāṇajihvākāyamanaḥsaṁsparśajā cetanā | ",
  "sbh2.7:6.3": "cetanāṁ ca saṁjñā ca sthāpayitvā | ",
  "sbh2.7:6.4": "ye tadanye caitasikā dharmāḥ | ",
  "sbh2.7:7.1": "tatra vijñānaskandhaḥ katamaḥ | ",
  "sbh2.7:7.2": "yaccittaṁ manovijñānaṁ | ",
  "sbh2.7:7.3": "te punaḥ ṣaḍvijñānakāyāḥ | ",
  "sbh2.7:7.4": "cakṣurvijñānaṁ śrotraghrāṇajihvākāyamanovijñānaṁ | ",
  "sbh2.7:7.5": "sā caiṣā vedanā saṁjñā saṁskārastaccaitadvijñānaṁ | ",
  "sbh2.7:7.6": "atītānāgatapratyutpannamādhyātmikaṁ vā bāhyaṁ vā iti vistareṇa pūrvavat | ",
  "sbh2.7:7.7": "ima ucyante skandhāḥ | ",
  "sbh2.7:8.1": "skandhakauśalyaṁ katamat | ",
  "sbh2.7:8.2": "ya etānyathoddiṣṭāndharmān nānātmakatayā ca jānāti | ",
  "sbh2.7:8.3": "bahvātmakatayā ca, na tataḥ paramupalabhate | ",
  "sbh2.7:8.4": "vikalpayati vā | ",
  "sbh2.7:8.5": "idamucyate samāsataḥ skandhakauśalyam | ",
  "sbh2.7:9.1": "tatra katamā nānātmakatā skandhānāmanya eva rūpaskandho 'nyo vedanāskandha evaṁ | ",
  "sbh2.7:9.2": "anyo yāvadvijñānaskandha iyaṁ nānātmakatā | ",
  "sbh2.7:10.1": "tatra katamā bahvātmakatā | ",
  "sbh2.7:10.2": "yo rūpaskandho nekavidho nānāprakāraḥ | ",
  "sbh2.7:10.3": "bhūtalaukikabhedenānāgatapratyutpannādikena ca | ",
  "sbh2.7:10.4": "prakārabhedena | ",
  "sbh2.7:10.5": "iyamucyate anekātmakatā | ",
  "sbh2.7:10.6": "rūpaskandhasyaivamavaśiṣṭānāṁ skandhānāṁ yathāyogaṁ veditavyam | ",
  "sbh2.7:11.1": "kiṁ ca na tasmātparaṁ upalabhate, vikalpayati | ",
  "sbh2.7:11.2": "skandhamātramupalabhate | ",
  "sbh2.7:11.3": "vastumātraṁ no tu skandhavyatirekeṇātmānamupalabhate | ",
  "sbh2.7:11.4": "nityadhruvamavipariṇāmadharmakaṁ, nāpyātmīyaṁ kiṁcididaṁ nopalabhate | ",
  "sbh2.7:11.5": "no vikalpayati tasmātpareṇa | ",
  "sbh2.7:12.1": "tatra katame dhātavaḥ | ",
  "sbh2.7:12.2": "katamaddhātukauśalyaṁ | ",
  "sbh2.7:12.3": "āha | ",
  "sbh2.7:12.4": "aṣṭādaśa dhātavaḥ | ",
  "sbh2.7:12.5": "cakṣurdhātū rūpadhātuścakṣurvijñānadhātuḥ | ",
  "sbh2.7:12.6": "śrotradhātuḥ | ",
  "sbh2.7:12.7": "śabdadhātuḥ | ",
  "sbh2.7:12.8": "śrotravijñānadhātuḥ | ",
  "sbh2.7:12.9": "ghrāṇadhātuḥ | ",
  "sbh2.7:12.10": "gandhadhātuḥ | ",
  "sbh2.7:12.11": "ghrāṇavijñānadhātuḥ | ",
  "sbh2.7:12.12": "jihvādhātū rasadhātuḥ | ",
  "sbh2.7:12.13": "jihvāvijñānadhātuḥ | ",
  "sbh2.7:12.14": "kāyadhātuḥ, spraṣṭavyadhātuḥ, kāyavijñānadhāturdharmadhāturmanovijñānadhāturima ucyante dhātavaḥ | ",
  "sbh2.7:13.1": "yatpunaretānaṣṭādaśadharmān svakasvakāddhātoḥ svakasvakādbījāt | ",
  "sbh2.7:13.2": "svakasvakādgotrājjāyante nirvartante prādurbhavantīti | ",
  "sbh2.7:13.3": "jānāti rocayatyupanidhyāti | ",
  "sbh2.7:13.4": "idamucyate dhātukauśalyaṁ | ",
  "sbh2.7:13.5": "yadaṣṭādaśānāṁ dharmāṇāṁ svakasvakāddhātoḥ pravṛttiṁ jānāti | ",
  "sbh2.7:13.6": "tadevameti hetupratyayakauśalyametadyaduta dhātukauśalyaṁ | ",
  "sbh2.7:14.1": "tatra katamānyāyatanāni | ",
  "sbh2.7:14.2": "katamadāyatanakauśalyamāha | ",
  "sbh2.7:14.3": "dvādaśāyatanāni | ",
  "sbh2.7:14.4": "cakṣurāyatanaṁ, rūpāyatanaṁ | ",
  "sbh2.7:14.5": "śrotrāyatanaṁ | ",
  "sbh2.7:14.6": "śabdāyatanaṁ | ",
  "sbh2.7:14.7": "ghrāṇāyatanaṁ | ",
  "sbh2.7:14.8": "gandhāyatanaṁ | ",
  "sbh2.7:14.9": "jihvāyatanaṁ | ",
  "sbh2.7:14.10": "rasāyatanaṁ | ",
  "sbh2.7:14.11": "kāyāyatanaṁ | ",
  "sbh2.7:14.12": "spraṣṭavyāyatanaṁ, mana-āyatanaṁ, dharmāyatanaṁ ca | ",
  "sbh2.7:14.13": "imānyucyante āyatanāni | ",
  "sbh2.7:15.1": "katamadāyatanakauśalyaṁ | ",
  "sbh2.7:15.2": "tatra cakṣuradhipatiḥ rūpāṇyālambanaṁ cakṣurvijñānasya saṁprayogasyotpattaye | ",
  "sbh2.7:15.3": "samanantaraniruddhaṁ ca manaḥ samanantarapratyayaḥ | ",
  "sbh2.7:15.4": "tatra śrotramadhipatiḥ | ",
  "sbh2.7:15.5": "śabda ālambanaṁ | ",
  "sbh2.7:15.6": "samanantaraniruddhaṁ ca manaḥ samanantarapratyayaḥ | ",
  "sbh2.7:15.7": "śrotravijñānasya sasaṁprayogasyotpattaye | ",
  "sbh2.7:15.8": "evaṁ yāvanmanaḥ samanantaraṁ tajjo manasikāro 'dhipatipratyayo dharmālambanaṁ dharma ālambanaṁ manovijñānasya saṁprayogasyotpattaye iti | ",
  "sbh2.7:15.9": "tribhiḥ pratyayaiḥ samanantarapratyayena, ālambanapratyayenādhipatipratyayena ca | ",
  "sbh2.7:15.10": "ṣaṇṇāṁ vijñānakāyānāṁ pravṛttirbhavati | ",
  "sbh2.7:15.11": "sasaṁprayogāṇāmiti | ",
  "sbh2.7:15.12": "yadevamādhyātmikabāhyeṣvāyataneṣu pratyayakauśalyamidamucyate āyatanakauśalyam | ",
  "sbh2.7:16.1": "tatra katamaḥ pratītyasamutpādaḥ katamat pratītyasamutpādakauśalyaṁ | ",
  "sbh2.7:16.2": "āha | ",
  "sbh2.7:16.3": "avidyāpratyayāḥ saṁskārāḥ, saṁskārapratyayaṁ vijñānaṁ, vijñānapratyayaṁ nāmarūpaṁ | ",
  "sbh2.7:16.4": "vistareṇa yāvadevamasya kevalasya mahato duḥkhaskandhasya samudayo bhavatyayamucyate pratītyasamutpādaḥ | ",
  "sbh2.7:17.1": "yatpunardharmā eva dharmānabhiṣpandayanti dharmā eva dharmān pariṣpandayanti | ",
  "sbh2.7:17.2": "saṁskārā eva dharmāṇāmāhārakāḥ tena hetusamutpannatvāt pratītyasamutpannatvāt vā abhūtvā bhavanti | ",
  "sbh2.7:17.3": "bhūtvā ca prativigacchanti | ",
  "sbh2.7:17.4": "tasmādanityā ete saṁskārā ye punaranityāste jātidharmāṇo, jarādharmāṇo, vyādhidharmāṇo, maraṇadharmāṇaḥ, śokaparidevaduḥkhadaurmanasyopāyāsadharmāṇaḥ | ",
  "sbh2.7:17.5": "te jarādharmitvādyāvadupāyāsadharmitvāt | ",
  "sbh2.7:17.6": "duḥkhā, ye vā punarduḥkhā, asvatantrā, durbalāste anātmāna iti | ",
  "sbh2.7:17.7": "yadebhirākāraiḥ pratītyasamutpanneṣu dharmeṣu anityajñānaṁ, duḥkhajñānaṁ, nairātmyajñānaṁ | ",
  "sbh2.7:17.8": "idamucyate pratītyasamutpādakauśalyam | ",
  "sbh2.7:18.1": "sthānāsthānakauśalyaṁ punaḥ pratītyasamutpāda eva veditavyam | ",
  "sbh2.7:18.2": "tatrāyaṁ viśeṣaḥ | ",
  "sbh2.7:18.3": "sthānāsthānakauśalyena viṣamahetukatāṁ jānāti | ",
  "sbh2.7:18.4": "asti kuśalākuśalānāṁ karmaṇāṁ phalavipākaḥ | ",
  "sbh2.7:18.5": "akuśalānāmaniṣṭa iti | ",
  "sbh2.7:18.6": "yadevaṁ jñānamidamucyate sthānāsthānakauśalyam | ",
  "sbh2.7:19.1": "taccaitatpañcasthānakauśalyaṁ samāsataḥ svalakṣaṇakauśalyaṁ bhavati | ",
  "sbh2.7:19.2": "sāmānyalakṣaṇakauśalyaṁ ca | ",
  "sbh2.7:19.3": "tatra skandhakauśalyena svalakṣaṇakauśalyamākhyātaṁ | ",
  "sbh2.7:19.4": "avaśiṣṭaiḥ sāmānyalakṣaṇakauśalyamidamucyate kauśalyālambanam | "
}
